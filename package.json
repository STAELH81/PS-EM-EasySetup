{
  "name": "ps-em-easysetup",
  "version": "0.5.0",
  "description": "Guided Windows setup assistant for PlayStation and PlayStation 2 emulation setup.",
  "main": "src/main/main.js",
  "author": "STAELH81",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main/system.js && node --check src/main/main.js && node --check src/main/preload.js && node --check src/renderer/app.js",
    "build": "electron-builder --win nsis --publish never",
    "build:dir": "electron-builder --dir",
    "prestart": "node scripts/generate-icons.js",
    "prebuild": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "electron": "^42.11.4",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "yauzl": "^3.3.1"
  },
  "productName": "PS-EM EasySetup",
  "build": {
    "appId": "com.staelh81.psemeasysetup",
    "productName": "PS-EM EasySetup",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PS-EM EasySetup",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
